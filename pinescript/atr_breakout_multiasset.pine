// This Pine Script(TM) code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
//
// ATR Breakout Strategy with Volatility Targeting
//
// Multi-asset deployment-ready strategy for BTC/USDT, ETH/USDT, SOL/USDT on 1h.
//
// Core Logic (from strategies/atr_breakout_strategy.py):
//   LONG  when close > SMA(close, sma_period) + atr_mult * ATR(atr_period)
//   SHORT when close < SMA(close, sma_period) - atr_mult * ATR(atr_period)
//   Positions are held (forward-filled) until the opposite signal fires.
//   There is NO flat zone -- once a breakout occurs, position is held
//   until an opposite-side breakout.
//
// Volatility Targeting Overlay:
//   Realized vol  = annualized stdev of hourly log-returns over trailing 1440 bars (60 days at 1h)
//   Target vol    = 25% annualized
//   Position scale = clamp(target_vol / realized_vol, 0.5, 2.0)
//   The strategy order size is scaled by this factor.
//
// Walk-forward validated parameters (across 2021-2026 BTC regimes):
//   sma_period = 10, atr_period = 14, atr_mult = 3.0
//
// ATR uses Wilder's smoothing (RMA), which matches ta.atr() in PineScript
// and ewm(alpha=1/period) in the Python backtester.

//@version=5
strategy("ATR Breakout + Vol Target", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.1, slippage=1, calc_on_every_tick=false, process_orders_on_close=false)

// =============================================================================
// INPUTS
// =============================================================================

grp_core = "Core ATR Breakout"
smaPeriod   = input.int(10,   "SMA Period",       minval=2,   maxval=100,  group=grp_core)
atrPeriod   = input.int(14,   "ATR Period",       minval=2,   maxval=100,  group=grp_core)
atrMult     = input.float(3.0,"ATR Multiplier",   minval=0.5, maxval=10.0, step=0.25, group=grp_core)

grp_vol = "Volatility Targeting"
useVolTarget  = input.bool(true, "Enable Vol Targeting",            group=grp_vol)
volWindow     = input.int(1440,  "Realized Vol Window (bars)", minval=60, maxval=5000, group=grp_vol, tooltip="60 days * 24 hours = 1440 bars at 1h resolution")
targetVol     = input.float(0.25,"Target Annualized Volatility",    minval=0.05,maxval=1.0, step=0.05, group=grp_vol)
minScale      = input.float(0.5, "Min Position Scale",             minval=0.1, maxval=1.0, step=0.1, group=grp_vol)
maxScale      = input.float(2.0, "Max Position Scale",             minval=1.0, maxval=5.0, step=0.25, group=grp_vol)

grp_alert = "Alert Messages"
alertLongMsg  = input.string("LONG",  "Long Alert Message",  group=grp_alert)
alertShortMsg = input.string("SHORT", "Short Alert Message", group=grp_alert)

// =============================================================================
// INDICATORS
// =============================================================================

// --- SMA of close ---
smaVal = ta.sma(close, smaPeriod)

// --- ATR (Wilder's RMA smoothing, matches Python ewm(alpha=1/period)) ---
atrVal = ta.atr(atrPeriod)

// --- Breakout bands ---
upperBand = smaVal + atrMult * atrVal
lowerBand = smaVal - atrMult * atrVal

// =============================================================================
// SIGNAL LOGIC
// =============================================================================
// Matches Python: signals[close > upper] = 1, signals[close < lower] = -1,
// then forward-fill (replace 0 with NA, ffill, fillna(0)).
// In PineScript we use a persistent var to hold the position state.

var int pos = 0

// A breakout above upper band triggers long
if close > upperBand
    pos := 1

// A breakout below lower band triggers short
if close < lowerBand
    pos := -1

// Note: when price is between the bands, pos retains its last value (forward-fill).
// The Python code does: signals.replace(0, pd.NA).ffill().fillna(0)
// This means once a signal fires, it holds until the opposite signal fires.
// The initial state (before any breakout) is flat (0), which matches fillna(0).

// =============================================================================
// VOLATILITY TARGETING (POSITION SIZING)
// =============================================================================
// Compute trailing realized annualized volatility from hourly log-returns.
// Annualization factor: sqrt(365.25 * 24) for hourly bars = sqrt(8766).

logReturn   = math.log(close / close[1])
realizedVol = ta.stdev(logReturn, volWindow) * math.sqrt(8766.0)

// Position scale factor
rawScale    = targetVol / math.max(realizedVol, 0.001)  // avoid division by zero
posScale    = useVolTarget ? math.max(minScale, math.min(rawScale, maxScale)) : 1.0

// Compute order size as percentage of equity, scaled by vol target
orderPct    = 100.0 * posScale  // base is 100% of equity

// =============================================================================
// ORDER EXECUTION
// =============================================================================
// Enter long: when signal flips to +1 and we are not already long
if pos == 1 and strategy.position_size <= 0
    strategy.entry("Long", strategy.long, qty=strategy.equity / close * posScale)
    alert(alertLongMsg, alert.freq_once_per_bar_close)

// Enter short: when signal flips to -1 and we are not already short
if pos == -1 and strategy.position_size >= 0
    strategy.entry("Short", strategy.short, qty=strategy.equity / close * posScale)
    alert(alertShortMsg, alert.freq_once_per_bar_close)

// Resize position if vol-target scale changes materially while already in position
// (re-entry with new qty effectively resizes)
if useVolTarget and strategy.position_size != 0
    absCurrentQty = math.abs(strategy.position_size)
    desiredQty    = strategy.equity / close * posScale
    // Only resize if >10% difference to avoid excessive churn
    if math.abs(desiredQty - absCurrentQty) / absCurrentQty > 0.10
        if pos == 1
            strategy.entry("Long", strategy.long, qty=desiredQty)
        if pos == -1
            strategy.entry("Short", strategy.short, qty=desiredQty)

// =============================================================================
// SIGNAL TRANSITION DETECTION (for plots and alerts)
// =============================================================================
longEntry  = pos == 1  and pos[1] != 1
shortEntry = pos == -1 and pos[1] != -1

// Note: alertcondition() is only available in indicator() mode, not strategy().
// For strategy alerts, the alert() calls in the order execution block above
// fire on each entry. To create TradingView alerts from this strategy, use:
//   "Create Alert" -> Condition: "ATR Breakout + Vol Target" -> "Order fills only"

// =============================================================================
// PLOTS - Main Chart (overlay=true)
// =============================================================================

// SMA line
plot(smaVal,    "SMA",         color=color.new(color.yellow, 20), linewidth=2)

// ATR breakout bands
pUpper = plot(upperBand, "Upper Band", color=color.new(color.green, 40), linewidth=1)
pLower = plot(lowerBand, "Lower Band", color=color.new(color.red,   40), linewidth=1)

// Fill between bands
fill(pUpper, pLower, color=color.new(color.gray, 90), title="Band Fill")

// Background tint for current position
posBgColor = pos == 1 ? color.new(color.green, 90) : pos == -1 ? color.new(color.red, 90) : na
bgcolor(posBgColor, title="Position Background")

// Signal markers on breakout transitions
plotshape(longEntry, style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, title="Long Signal")
plotshape(shortEntry, style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, title="Short Signal")

// =============================================================================
// VOLATILITY TARGET DATA (Data Window + Status Line)
// =============================================================================
// PineScript v5 strategies with overlay=true cannot create a separate pane.
// The vol-target data is exposed in TradingView's Data Window (right sidebar)
// and Status Line so you can monitor it in real time.
//
// To view as a separate pane: right-click the strategy on the chart ->
// "Move to" -> "New pane below". This moves the ENTIRE strategy to a
// separate pane. Alternatively, create a companion indicator (see below).

plot(posScale,    "Vol Scale",    display=display.data_window + display.status_line, color=color.blue)
plot(realizedVol, "Realized Vol", display=display.data_window, color=color.orange)
plot(targetVol,   "Target Vol",   display=display.data_window, color=color.gray)

// =============================================================================
// COMPANION INDICATOR (copy into a separate script to get a vol-scale pane):
// =============================================================================
//
// //@version=5
// indicator("ATR Breakout Vol Scale", overlay=false)
// volWin   = input.int(1440, "Vol Window")
// tgtVol   = input.float(0.25, "Target Vol")
// minS     = input.float(0.5, "Min Scale")
// maxS     = input.float(2.0, "Max Scale")
// lr       = math.log(close / close[1])
// rv       = ta.stdev(lr, volWin) * math.sqrt(8766.0)
// raw      = tgtVol / math.max(rv, 0.001)
// scale    = math.max(minS, math.min(raw, maxS))
// plot(scale, "Vol Scale", color=color.blue, linewidth=2)
// hline(1.0, "Neutral", color=color.gray, linestyle=hline.style_dashed)
// hline(minS, "Min", color=color.red, linestyle=hline.style_dotted)
// hline(maxS, "Max", color=color.green, linestyle=hline.style_dotted)

// =============================================================================
// INFO TABLE (top-right corner)
// =============================================================================
var table infoTbl = table.new(position.top_right, 2, 7, bgcolor=color.new(color.gray, 85), border_width=1, border_color=color.new(color.gray, 70))
if barstate.islast
    // Row 0: Strategy name
    table.cell(infoTbl, 0, 0, "ATR Breakout", text_color=color.white, text_size=size.small)
    paramStr = str.tostring(smaPeriod) + "/" + str.tostring(atrPeriod) + "/" + str.tostring(atrMult, "#.#")
    table.cell(infoTbl, 1, 0, paramStr, text_color=color.white, text_size=size.small)

    // Row 1: Position
    table.cell(infoTbl, 0, 1, "Position", text_color=color.white, text_size=size.small)
    posLabel = pos == 1 ? "LONG" : pos == -1 ? "SHORT" : "FLAT"
    posColor = pos == 1 ? color.green : pos == -1 ? color.red : color.gray
    table.cell(infoTbl, 1, 1, posLabel, text_color=posColor, text_size=size.small)

    // Row 2: ATR value
    table.cell(infoTbl, 0, 2, "ATR", text_color=color.white, text_size=size.small)
    table.cell(infoTbl, 1, 2, str.tostring(atrVal, "#.1"), text_color=color.white, text_size=size.small)

    // Row 3: Upper band
    table.cell(infoTbl, 0, 3, "Upper", text_color=color.white, text_size=size.small)
    table.cell(infoTbl, 1, 3, str.tostring(upperBand, "#.1"), text_color=color.green, text_size=size.small)

    // Row 4: Lower band
    table.cell(infoTbl, 0, 4, "Lower", text_color=color.white, text_size=size.small)
    table.cell(infoTbl, 1, 4, str.tostring(lowerBand, "#.1"), text_color=color.red, text_size=size.small)

    // Row 5: Realized vol
    table.cell(infoTbl, 0, 5, "Rlz Vol", text_color=color.white, text_size=size.small)
    table.cell(infoTbl, 1, 5, str.tostring(realizedVol * 100, "#.1") + "%", text_color=color.orange, text_size=size.small)

    // Row 6: Vol scale
    table.cell(infoTbl, 0, 6, "Vol Scale", text_color=color.white, text_size=size.small)
    scaleColor = posScale > 1.0 ? color.green : posScale < 1.0 ? color.orange : color.white
    table.cell(infoTbl, 1, 6, str.tostring(posScale, "#.##") + "x", text_color=scaleColor, text_size=size.small)
